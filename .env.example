# =====================================================================
# Autowra - environment template
# Copy to .env (never commit a real .env) and fill in values.
# Every integration below is OPTIONAL: when a value is missing the
# backend falls back to a clearly labelled development adapter.
# =====================================================================

# ---------- Runtime ----------
NODE_ENV=development
BACKEND_PORT=4000
# Public base URL of the API (used to build callback/webhook URLs)
API_PUBLIC_URL=http://localhost:4000

# ---------- Database (REQUIRED) ----------
# PostgreSQL connection string used by Prisma.
DATABASE_URL=postgresql://postgres@localhost:5432/autowra_dev?schema=public

# ---------- Authentication ----------
# Secret used to sign access/refresh JWTs. Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_COOLDOWN_SECONDS=30

# ---------- Development authentication ----------
# Allows logging in with a fixed OTP in NON-production environments only.
# The backend refuses to start with DEV_AUTH_ENABLED=true when NODE_ENV=production.
DEV_AUTH_ENABLED=true
DEV_AUTH_OTP=123456

# ---------- Object storage (uploads) ----------
# "local" writes to backend/storage (development only, not for production).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ---------- Payments (Razorpay) ----------
# When these are empty the backend uses the clearly labelled MOCK provider.
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- SMS OTP provider ----------
# "console" logs the OTP to the backend log (development only).
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=AUTOWRA
SMS_TEMPLATE_ID=

# ---------- Email ----------
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@autowra.example

# ---------- Push notifications ----------
PUSH_PROVIDER=expo
EXPO_ACCESS_TOKEN=

# ---------- Maps ----------
# Used by the mobile apps at build time and by the backend for geo lookup.
GOOGLE_MAPS_API_KEY=

# ---------- Business defaults ----------
DEFAULT_CURRENCY=INR
DEFAULT_TAX_PERCENT=18
PLATFORM_COMMISSION_PERCENT=20

# =====================================================================
# Mobile apps (apps/customer, apps/partner)
# Expo only exposes variables prefixed with EXPO_PUBLIC_ to the bundle.
# NEVER place a secret here - the bundle is public.
# =====================================================================
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_BRAND_NAME=Autowra
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# =====================================================================
# Admin dashboard (apps/admin)
# =====================================================================
# Server-side only. Do not prefix with NEXT_PUBLIC_.
ADMIN_API_URL=http://localhost:4000/api/v1
